# Copy to .env.local. Settings: docs/database.md. Keep real credentials out of Git.
DATABASE_URL=postgres://triptogether:triptogether@localhost:5432/triptogether
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
ADMIN_EMAILS=

# Gasoline Intelligence: docs/gasoline-intelligence.md and docs/google-maps-setup.md.
# Server key: restrict to Routes API + Places API (New). Never use NEXT_PUBLIC_ for this key.
GOOGLE_MAPS_API_KEY=
# Separate browser key: restrict to Maps JavaScript API and your website referrers. It is public by design.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# DEMO_MAP_ID is for local testing; use your own JavaScript map ID for deployment.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
# DeepSeek is used only for vehicle identification.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# How far from the fastest route to look for stations, in miles (1-30).
FUEL_CORRIDOR_MILES=10
# The most paid Places requests one search may make (1-30). Long routes are sampled when this is too low.
FUEL_MAX_STATION_SEARCHES=10
# Warn when a leg of the plan is longer than this many minutes of driving (30-600).
FUEL_REST_WARNING_MINUTES=180
