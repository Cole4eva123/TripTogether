# Copy to .env.local. Keep real credentials out of Git.
# DeepSeek is used only for vehicle identification.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Server key: restrict to Routes API + Places API (New). Never use NEXT_PUBLIC_ for this key.
GOOGLE_MAPS_API_KEY=
# Separate browser key: restrict to Maps JavaScript API and your website referrers.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# DEMO_MAP_ID is for local testing; use your own JavaScript map ID for deployment.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
