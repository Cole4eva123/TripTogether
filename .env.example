# Copy to .env.local. Keep real credentials out of Git.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Optional: official weekly state averages for EIA-supported states. AAA remains the fallback.
EIA_API_KEY=
FUEL_STATION_PROVIDER=auto
# Use "web" to research cited station locators if your network cannot reach Overpass.

# Swap these for your own or commercial services before scaling.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSRM_BASE_URL=https://router.project-osrm.org
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OSM_USER_AGENT=TripTogether/0.1 (local road trip planner; https://github.com/Cole4eva123/TripTogether)
